# ==================== Telegram Configuration ====================

# API credentials from https://my.telegram.org
TELEGRAM_API_ID="00000000"
TELEGRAM_API_HASH="0000000000aaaa0a0000aaa000000000"

# Your phone number (with + and country code)
TELEGRAM_PHONE="+000000000000"

# Target group ID (find it using @userinfobot in the group)
TELEGRAM_CHAT_ID="-0000000000000"

# Number of historical messages to import on startup
# 0 = disable history import, only listen for new messages
# 100 = import last 100 messages (default)
# 999999 = import ALL messages available in the group
TELEGRAM_HISTORY_LIMIT="999999"

# ==================== Database Configuration ====================

# SQLite database path (relative paths are relative to the script directory)
DATABASE_PATH=sqlite:///data/database.db

# ==================== Workers Configuration ====================

GOOGLE_MAPS_API_KEY = "AaaaaaaaaaaaAaaa0000aa0aaa00a0a0a0aaaaa"